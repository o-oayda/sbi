include: "configuration.smk"


rule all:
    input:
        FINAL_OUTPUTS


rule resolve_racs_experiment:
    input:
        EXPERIMENT_CONFIG_PATHS
    output:
        config=RESOLVED_EXPERIMENT_CONFIG_PATH,
    run:
        destination = Path(output.config)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(
            yaml.safe_dump(EXPERIMENT, sort_keys=False),
            encoding="utf-8",
        )


rule validate_racs_data:
    input:
        dataset_registry=DATASET_REGISTRY_PATH,
        catalogue=CATALOGUE_PATH,
        paf_temperature_manifest=(
            () if PAF_TEMPERATURE_MANIFEST_PATH is None
            else PAF_TEMPERATURE_MANIFEST_PATH
        ),
        paf_temperature_files=PAF_TEMPERATURE_VALIDATION_FILES,
        noise_map_manifest=NOISE_MAP_MANIFEST_PATH,
        noise_map_files=NOISE_MAP_VALIDATION_FILES,
    output:
        report=DATA_VALIDATION_PATH,
    params:
        output_dir=DATA_VALIDATION_DIR,
        catalogue_id=CATALOGUE_DATASET_ID,
        paf_cli_args=PAF_VALIDATION_CLI_ARGS,
        noise_map_cli_args=NOISE_MAP_VALIDATION_CLI_ARGS,
    log:
        f"{DATA_VALIDATION_DIR}/validation.log"
    shell:
        """
        mkdir -p {params.output_dir:q}
        dipolesbi-validate-racs-data \
            --registry {input.dataset_registry:q} \
            --catalogue-id {params.catalogue_id:q} \
            --catalogue-path {input.catalogue:q} \
            {params.paf_cli_args} \
            {params.noise_map_cli_args} \
            --output {output.report:q} \
            > {log:q} 2>&1
        """


rule generate_mask:
    input:
        config=OBSERVATION_CONFIG_PATH,
        mask_config=MASK_CONFIG_INPUT,
    output:
        mask=MASK_PATH,
        plot=MASK_PLOT_PATH,
    params:
        output_dir=OBSERVATION_DIR,
        preparation_implementation_fingerprint=(
            PREPARATION_IMPLEMENTATION_FINGERPRINT
        ),
        jax_platforms=EXECUTION["jax_platforms"],
    log:
        f"{OBSERVATION_DIR}/mask-generation.log"
    shell:
        """
        mkdir -p {params.output_dir:q}
        JAX_PLATFORMS={params.jax_platforms:q} \
            dipolesbi-generate-racs-mask \
            --config {input.config:q} \
            --output {output.mask:q} \
            --plot-output {output.plot:q} \
            > {log:q} 2>&1
        """


rule make_observation:
    input:
        data_validation=rules.validate_racs_data.output.report,
        config=OBSERVATION_CONFIG_PATH,
        mask=rules.generate_mask.output.mask,
        catalogue=CATALOGUE_PATH,
        paf_temperature_files=PAF_TEMPERATURE_FILES,
        noise_map_files=NOISE_MAP_FILES,
    output:
        observation=OBSERVATION_PATH,
        native_observation=NATIVE_OBSERVATION_PATH,
        native_density_plot=NATIVE_DENSITY_PLOT_PATH,
    params:
        output_dir=OBSERVATION_DIR,
        paf_cli_args=PAF_PREPARATION_CLI_ARGS,
        noise_map_cli_args=NOISE_MAP_PREPARATION_CLI_ARGS,
        preparation_implementation_fingerprint=(
            PREPARATION_IMPLEMENTATION_FINGERPRINT
        ),
        jax_platforms=EXECUTION["jax_platforms"],
    threads:
        EXECUTION["threads"]
    resources:
        mem_mb=EXECUTION["mem_mb"]
    log:
        f"{OBSERVATION_DIR}/preparation.log"
    shell:
        """
        mkdir -p {params.output_dir:q}
        JAX_PLATFORMS={params.jax_platforms:q} \
            dipolesbi-prepare-racs-observation \
            --config {input.config:q} \
            --mask-path {input.mask:q} \
            --catalogue-path {input.catalogue:q} \
            {params.paf_cli_args} \
            {params.noise_map_cli_args} \
            --output {output.observation:q} \
            --native-output {output.native_observation:q} \
            --native-plot-output {output.native_density_plot:q} \
            > {log:q} 2>&1
        """


rule infer_racs:
    input:
        experiment_config=rules.resolve_racs_experiment.output.config,
        observation_config=OBSERVATION_CONFIG_PATH,
        inference_config=INFERENCE_CONFIG_PATH,
        catalogue=CATALOGUE_PATH,
        paf_temperature_files=PAF_TEMPERATURE_FILES,
        noise_map_files=NOISE_MAP_FILES,
        prepared_observation=rules.make_observation.output.observation,
    output:
        samples=SAMPLES_PATH,
        round_evidence=ROUND_EVIDENCE_PATH,
        checkpoint=CHECKPOINT_PATH,
        observation=RESULT_OBSERVATION_PATH,
        model_config=MODEL_CONFIG_PATH,
        configs=CONFIGS_PATH,
        run_command=RUN_COMMAND_PATH,
    params:
        output_dir=RESULT_DIR,
        paf_cli_args=PAF_INFERENCE_CLI_ARGS,
        noise_map_cli_args=NOISE_MAP_INFERENCE_CLI_ARGS,
        cli_args=command_line_arguments(INFERENCE_ARGS),
        inference_implementation_fingerprint=INFERENCE_IMPLEMENTATION_FINGERPRINT,
        jax_platforms=EXECUTION["jax_platforms"],
    threads:
        EXECUTION["threads"]
    resources:
        mem_mb=EXECUTION["mem_mb"]
    log:
        f"{RESULT_DIR}/inference.log"
    shell:
        """
        mkdir -p {params.output_dir:q}
        JAX_PLATFORMS={params.jax_platforms:q} \
            dipolesbi-infer-racs \
            {params.cli_args} \
            --catalogue_path {input.catalogue:q} \
            {params.paf_cli_args} \
            {params.noise_map_cli_args} \
            --observation_config {input.observation_config:q} \
            --inference_config {input.inference_config:q} \
            --reference_observation {input.prepared_observation:q} \
            --out_dir {params.output_dir:q} \
            > {log:q} 2>&1
        """


rule package_racs_analysis:
    input:
        final_posterior=rules.infer_racs.output.samples,
        round_evidence=rules.infer_racs.output.round_evidence,
        reference_observation=rules.infer_racs.output.observation,
        native_reference_observation=(
            rules.make_observation.output.native_observation
        ),
        experiment_config=rules.resolve_racs_experiment.output.config,
        observation_config=OBSERVATION_CONFIG_PATH,
        inference_config=INFERENCE_CONFIG_PATH,
        data_validation=rules.validate_racs_data.output.report,
        dataset_registry=DATASET_REGISTRY_PATH,
        paf_manifest=(
            () if PAF_TEMPERATURE_MANIFEST_PATH is None
            else PAF_TEMPERATURE_MANIFEST_PATH
        ),
        model_config=rules.infer_racs.output.model_config,
        configs=rules.infer_racs.output.configs,
        run_command=rules.infer_racs.output.run_command,
        project="pyproject.toml",
        software_lock="uv.lock",
    output:
        archive=ANALYSIS_ARCHIVE_PATH,
        checksum=ANALYSIS_CHECKSUM_PATH,
    params:
        artifacts_root="artifacts",
        experiment_id=EXPERIMENT_ID,
        implementation_fingerprint=IMPLEMENTATION_FINGERPRINT,
        paf_cli_args=PAF_PACKAGING_CLI_ARGS,
    log:
        f"{ARTIFACT_DIR}/packaging.log"
    shell:
        """
        mkdir -p {ARTIFACT_DIR:q}
        dipolesbi-package-racs-analysis \
            --experiment-id {params.experiment_id:q} \
            --artifacts-root {params.artifacts_root:q} \
            --repository-root . \
            --implementation-fingerprint {params.implementation_fingerprint:q} \
            --final-posterior {input.final_posterior:q} \
            --round-evidence {input.round_evidence:q} \
            --reference-observation {input.reference_observation:q} \
            --native-reference-observation {input.native_reference_observation:q} \
            --experiment-config {input.experiment_config:q} \
            --observation-config {input.observation_config:q} \
            --inference-config {input.inference_config:q} \
            --data-validation-report {input.data_validation:q} \
            --dataset-registry {input.dataset_registry:q} \
            {params.paf_cli_args} \
            --model-config {input.model_config:q} \
            --configs {input.configs:q} \
            --run-command {input.run_command:q} \
            --pyproject {input.project:q} \
            --uv-lock {input.software_lock:q} \
            --allow-dirty
            > {log:q} 2>&1
        """
